# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Application
NODE_ENV=development
PORT=5000

# MongoDB
# For a local server: mongodb://localhost:27017/ecommerce_marketplace
MONGODB_URI=mongodb://localhost:27017/ecommerce_marketplace

# CORS origin allowed to call the API (the frontend origin)
CORS_ORIGIN=http://localhost:3000

# Base URL of the frontend, used for redirects and email links
CLIENT_URL=http://localhost:3000

# JWT - use long random strings (min 32 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the "Authorized redirect URIs" in the Google Cloud console
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Email (SMTP)
# When SMTP_HOST is empty, development uses nodemailer's Ethereal test
# account and the preview URL is logged to the console.
# For production, fill in your SMTP provider details:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-Commerce Marketplace <no-reply@yourdomain.com>"

# Redis (optional, for caching and background jobs)
# Leave empty to disable Redis caching and use in-memory processing
REDIS_URL=

# Razorpay payment gateway (https://dashboard.razorpay.com/app/keys)
# Leave RAZORPAY_KEY_ID/SECRET empty to run the gateway in MOCK mode:
# payments are simulated end-to-end (signatures still verified) so the
# full flow works without credentials - use sandbox keys for real testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay's dashboard (Webhooks section); used to
# verify x-razorpay-signature on /api/v1/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (https://console.cloudinary.com)
# Used for product images, user avatars, and seller documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
