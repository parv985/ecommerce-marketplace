# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Application
NODE_ENV=development
PORT=5000

# MongoDB
# For a local server: mongodb://localhost:27017/ecommerce_marketplace
MONGODB_URI=mongodb://localhost:27017/ecommerce_marketplace

# CORS origin(s) allowed to call the API (the frontend origin).
# Comma-separate several origins, e.g. production + a preview URL:
#   CORS_ORIGIN=https://nexcart.vercel.app,https://nexcart-git-dev.vercel.app
CORS_ORIGIN=http://localhost:3000

# Base URL of the frontend, used for redirects and email links.
# This is where the Google OAuth callback sends the browser after sign-in,
# so it must be the deployed frontend on Render (no trailing slash).
CLIENT_URL=http://localhost:3000

# JWT - use long random strings (min 32 characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Dedicated key material for TOTP secrets stored at rest (optional, min 32 chars).
# Leave empty and secrets are encrypted with a key derived from
# JWT_ACCESS_SECRET - which means ROTATING JWT_ACCESS_SECRET MAKES EVERY
# STORED TOTP SECRET UNDECRYPTABLE ("Unsupported state or unable to
# authenticate data" on /auth/2fa/verify) and those users must re-enroll.
# Set a strong random value here to keep the two independent; existing
# secrets keep working either way, because decryption tries both keys.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Backend-only secrets: never put these in a VITE_* frontend variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match ONE of the "Authorized redirect URIs" in the Google
# Cloud console, character for character (scheme, host, port and path).
# It always points at THIS backend's callback route, never at the frontend:
#   local (direct to the API): http://localhost:5000/api/v1/auth/google/callback
#   local (through the Vite proxy): http://localhost:3000/api/v1/auth/google/callback
#   Render:  https://<backend-service>.onrender.com/api/v1/auth/google/callback
# A wrong value is the usual cause of "Google sign-in lands on a 404".
# If left empty, the callback URL is derived from the incoming request.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Email (SMTP)
# When SMTP_HOST is empty, development uses nodemailer's Ethereal test
# account and the preview URL is logged to the console.
# For production, fill in your SMTP provider details:
#
# Every notification a buyer can open from the bell (order confirmed /
# shipped / delivered, refunds, returns, seller messages, admin broadcasts,
# ...) is also emailed to the address registered on their account, so real
# delivery needs a real SMTP relay here. Recipients are ALWAYS read from the
# user document - no endpoint accepts an address to send to, and nothing in
# this block is ever exposed to the frontend.
#
# Any deliverable mailbox works as a recipient: real inboxes and disposable
# test inboxes such as YOPmail (register a buyer as e.g. buyer123@yopmail.com
# and read the mail at https://yopmail.com - no signup needed). YOPmail can
# only be reached through a real relay, so SMTP_HOST must be set for that.
#
# Gmail (the usual free option) - create an App Password at
# https://myaccount.google.com/apppasswords (2-step verification must be on),
# then either:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true   (implicit TLS)
# or
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false  (STARTTLS)
# with SMTP_USER=you@gmail.com and SMTP_PASS=<16-char app password>.
# A transactional provider (SES, Postmark, Brevo, Mailgun, ...) works the same
# way: its SMTP credentials go in these five variables and nowhere else.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Display sender; must be an address your relay is allowed to send from.
SMTP_FROM="E-Commerce Marketplace <no-reply@yourdomain.com>"

# Refresh-token cookie SameSite policy: strict | lax | none.
# Leave empty for the defaults - "lax" in development and "none" in
# production, which is required when the frontend and the API are served
# from different origins (the normal Render setup) so that
# POST /api/v1/auth/refresh can send the cookie cross-site.
#COOKIE_SAME_SITE=

# Redis (optional, for caching and background jobs)
# Leave empty to disable Redis caching and use in-memory processing
REDIS_URL=

# Razorpay payment gateway (https://dashboard.razorpay.com/app/keys)
# Leave RAZORPAY_KEY_ID/SECRET empty to run the gateway in MOCK mode:
# payments are simulated end-to-end (signatures still verified) so the
# full flow works without credentials - use sandbox keys for real testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay's dashboard (Webhooks section); used to
# verify x-razorpay-signature on /api/v1/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (https://console.cloudinary.com)
# Used for product images, user avatars, and seller documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq AI API (https://console.groq.com/keys)
# Used for natural-language product search and AI commerce features.
# Backend-only secret: never put this in a VITE_* frontend variable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
