# Backend API URL (a PUBLIC value - it is inlined into the client bundle).
#
# Local dev: leave it unset (or "/api/v1") so requests go through the Vite
# dev server, which proxies /api/* to the backend on :5000, or set it to
# the absolute API URL to call the backend directly.
# Deployed: set it to the absolute backend URL, e.g.
#   VITE_API_URL=https://nexcart-api.onrender.com/api/v1
# because a static host has no proxy to forward /api/v1 to the API.
VITE_API_URL=http://localhost:5000/api/v1

# Never put secrets in this file: every VITE_* value ends up in the
# browser bundle. Google sign-in needs nothing but the API URL above -
# GOOGLE_CLIENT_SECRET stays in the backend environment.
